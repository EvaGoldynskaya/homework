generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(cuid())
  name String
  birthdate String
  email String @unique
  tasks Task[]
}

model Task{
  id String @id @default(cuid())
  name String
  user User @relation(fields: [userId], references: [id])
  userId String
  description String
  deadline String
  status String
}